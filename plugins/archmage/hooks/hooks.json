{
  "description": "Map ARCHMAGE policy verdicts to Claude Code PreToolUse permission decisions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse.py\""
          }
        ]
      }
    ]
  }
}
